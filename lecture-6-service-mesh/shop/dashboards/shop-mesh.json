{
 "uid": "shop-mesh",
 "title": "Shop — mesh и canary",
 "timezone": "browser",
 "schemaVersion": 39,
 "refresh": "15s",
 "time": {
  "from": "now-30m",
  "to": "now"
 },
 "tags": [
  "shop",
  "lab6"
 ],
 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "Доля трафика по версиям (traffic split)",
   "description": "Какая доля запросов от клиентов в mesh пришла на каждую версию (inbound-прокси, только mTLS-трафик).",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "min": 0,
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 10,
      "showPoints": "never"
     },
     "max": 1
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (deployment) (rate(response_total{direction=\"inbound\",namespace=\"__NS__\",tls=\"true\",deployment=~\"shop-api-v.*\"}[1m])) / ignoring(deployment) group_left sum(rate(response_total{direction=\"inbound\",namespace=\"__NS__\",tls=\"true\",deployment=~\"shop-api-v.*\"}[1m]))",
     "legendFormat": "{{deployment}}"
    }
   ]
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "Доля ошибок по версиям",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "min": 0,
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 10,
      "showPoints": "never"
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (deployment) (rate(response_total{direction=\"inbound\",namespace=\"__NS__\",tls=\"true\",deployment=~\"shop-api-v.*\",classification=\"failure\"}[1m])) / sum by (deployment) (rate(response_total{direction=\"inbound\",namespace=\"__NS__\",tls=\"true\",deployment=~\"shop-api-v.*\"}[1m]))",
     "legendFormat": "{{deployment}}"
    }
   ]
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "p95 латентности по версиям",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "ms",
     "min": 0,
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 10,
      "showPoints": "never"
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "histogram_quantile(0.95, sum by (le, deployment) (rate(response_latency_ms_bucket{direction=\"inbound\",namespace=\"__NS__\",tls=\"true\",deployment=~\"shop-api-v.*\"}[1m])))",
     "legendFormat": "{{deployment}}"
    }
   ]
  },
  {
   "id": 4,
   "type": "timeseries",
   "title": "Надёжность: ошибки backend и ошибки, которые видит клиент",
   "description": "Клиентский прокси Linkerd: попытки к backend против итоговых ответов клиенту после retries.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "min": 0,
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 10,
      "showPoints": "never"
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(rate(outbound_http_route_backend_response_statuses_total{namespace=\"__NS__\",parent_name=\"shop-api\",http_status=~\"5..\"}[1m])) / sum(rate(outbound_http_route_backend_response_statuses_total{namespace=\"__NS__\",parent_name=\"shop-api\"}[1m]))",
     "legendFormat": "backend: доля 5xx среди попыток"
    },
    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(rate(outbound_http_route_request_statuses_total{namespace=\"__NS__\",parent_name=\"shop-api\",http_status=~\"5..\"}[1m])) / sum(rate(outbound_http_route_request_statuses_total{namespace=\"__NS__\",parent_name=\"shop-api\"}[1m]))",
     "legendFormat": "клиент: доля 5xx среди запросов"
    }
   ]
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "Запросы клиента и попытки к backend",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 16,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps",
     "min": 0,
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 10,
      "showPoints": "never"
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(rate(outbound_http_route_request_statuses_total{namespace=\"__NS__\",parent_name=\"shop-api\"}[1m]))",
     "legendFormat": "запросы клиента"
    },
    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(rate(outbound_http_route_backend_requests_total{namespace=\"__NS__\",parent_name=\"shop-api\"}[1m]))",
     "legendFormat": "попытки к backend (с retries)"
    }
   ]
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "CPU: приложение api и прокси linkerd-proxy",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 16,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "cores",
     "min": 0,
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 10,
      "showPoints": "never"
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (container) (rate(container_cpu_usage_seconds_total{namespace=\"__NS__\",pod=~\"shop-api-.*\",container=~\"api|linkerd-proxy\"}[1m]))",
     "legendFormat": "{{container}}"
    }
   ]
  },
  {
   "id": 7,
   "type": "table",
   "title": "Сработавшие алерты",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 24,
    "w": 24,
    "h": 5
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "ALERTS{alertname=~\"Shop.*\",namespace=\"__NS__\"}",
     "instant": true,
     "format": "table"
    }
   ],
   "transformations": [
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true,
       "Value": true,
       "__name__": true
      }
     }
    }
   ]
  }
 ]
}